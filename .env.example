# =============================================================================
# Event Management System - Docker Environment Configuration
# =============================================================================
# Copy this file to .env before running: docker compose up -d --build

# -----------------------------------------------------------------------------
# Host Ports Mapping
# -----------------------------------------------------------------------------
FRONTEND_PORT=80
BACKEND_PORT=5000
AI_SERVICE_PORT=8000
MONGO_PORT=27017

# -----------------------------------------------------------------------------
# Frontend Build Settings
# -----------------------------------------------------------------------------
# In Docker, Nginx reverse-proxies /api requests to the backend container.
# Using /api gives unified single-origin access without CORS or cookie issues.
VITE_API_URL=/api

# -----------------------------------------------------------------------------
# Backend Settings
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Allowed frontend origins for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000

# JWT signing secret (REQUIRED - change to a long random secret in production)
JWT_SECRET=super_secret_event_management_jwt_key_replace_in_production_1234567890
JWT_EXPIRES_IN=1d
AUTH_COOKIE_NAME=em_token

# Cookie security flag:
# Set to 'false' for local Docker / HTTP testing so auth cookies are retained.
# Set to 'true' in production when deployed behind HTTPS / SSL.
COOKIE_SECURE=false

# QR Attendance signature secret
QR_TOKEN_SECRET=super_secret_qr_token_signing_key_replace_in_production_9876543210

# Automatic database seeding on backend container boot:
# 'true' will automatically seed test accounts (admin@gmail.com, organiser@gmail.com, user@gmail.com)
# 'false' leaves the database clean for production use.
AUTO_SEED=true

# Initial Admin credentials
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin@123

# Internal Docker network connection strings
AI_SERVICE_URL=http://ai-service:8000
AI_TIMEOUT_MS=20000
MONGODB_URI=mongodb://mongo:27017/event_management_system

# -----------------------------------------------------------------------------
# AI Service Settings
# -----------------------------------------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
