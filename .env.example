# =============================================================================
# EventFlow Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to `.env` in the repository root and adjust values as needed:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. Never commit `.env` containing real credentials to version control.
# 2. Generate a secure random JWT_SECRET for any production or lab deployment.
# 3. Browser-facing URLs must use localhost or host IP, NOT Docker internal hostnames.
# =============================================================================

# -----------------------------------------------------------------------------
# Node Environment & Port Bindings
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# -----------------------------------------------------------------------------
# Database Configuration (MongoDB)
# -----------------------------------------------------------------------------
# Inside Docker Compose, MongoDB is reached via the service name `mongodb`.
# Database name must remain `event_management_system`.
MONGODB_URI=mongodb://mongodb:27017/event_management_system
MONGODB_DB_NAME=event_management_system

# -----------------------------------------------------------------------------
# Client & Browser-Facing URLs
# -----------------------------------------------------------------------------
# Origin allowed by backend CORS (must match the browser URL used to open frontend)
CLIENT_URL=http://localhost:5173

# API URL baked into frontend client build (must be accessible from user's browser)
VITE_API_URL=http://localhost:5000/api

# -----------------------------------------------------------------------------
# Authentication & Cookie Settings
# -----------------------------------------------------------------------------
# REQUIRED: Secret key used to sign JWTs. Must be replaced with a secure random key.
# Generate on Linux/macOS/Windows: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_this_to_a_long_random_secret_in_production_32_chars_min

# Token lifetime (e.g. 1d, 12h, 30m)
JWT_EXPIRES_IN=1d

# Name of the HTTP-only cookie carrying the JWT
AUTH_COOKIE_NAME=em_token

# Set to false for plain HTTP deployments (e.g. local college lab without TLS)
# Set to true only when running behind HTTPS/SSL
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# QR Attendance Credential Signing (Optional)
# -----------------------------------------------------------------------------
# If unset, a stable HMAC key is derived from JWT_SECRET at runtime.
# QR_TOKEN_SECRET=change_this_to_a_distinct_long_random_secret

# -----------------------------------------------------------------------------
# Internal AI Service Configuration (FastAPI)
# -----------------------------------------------------------------------------
# Server-to-server URL used by the backend container to reach the AI container.
AI_SERVICE_URL=http://ai-service:8000
AI_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# Initial Demonstration Admin Account
# -----------------------------------------------------------------------------
# Consumed when running: docker compose exec backend npm run seed:admin
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin@123
