# Backend environment configuration.
# Copy this file to backend/.env and adjust values as needed.
# Do NOT commit backend/.env.

NODE_ENV=development
PORT=5000

# MongoDB connection string (no credentials for a local instance).
MONGODB_URI=mongodb://localhost:27017/event_management_system

# Origin allowed by CORS (the Vite dev server).
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Authentication (Phase 1)
# ---------------------------------------------------------------------------
# Secret used to sign JWTs. REQUIRED — the server refuses to start without it.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_this_to_a_long_random_secret

# JWT lifetime. Accepts "1d", "12h", "30m", "3600s" or a number of seconds.
JWT_EXPIRES_IN=1d

# Name of the HTTP-only cookie that carries the JWT.
AUTH_COOKIE_NAME=em_token

# ---------------------------------------------------------------------------
# QR attendance (Phase 7)
# ---------------------------------------------------------------------------
# Secret used to sign QR attendance credentials (HMAC-SHA256). OPTIONAL — if
# unset, a stable key is derived from JWT_SECRET at runtime. Set this to a
# distinct long random value to rotate or separate the QR signing key.
# QR_TOKEN_SECRET=change_this_to_a_long_random_secret

# ---------------------------------------------------------------------------
# AI service (Phase 5) — FastAPI planning-assistant service.
# The backend calls this server-to-server; the browser never contacts it.
# ---------------------------------------------------------------------------
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Initial admin account — used only by:  npm run seed:admin
# There is NO public admin registration. Do not commit real values.
# ---------------------------------------------------------------------------
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password_1
